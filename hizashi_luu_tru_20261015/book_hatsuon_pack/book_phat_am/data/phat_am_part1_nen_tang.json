            "japanese": {
              "system": "Pitch-accent (Trọng âm cao độ)",
              "levels": ["Cao (H)", "Thấp (L)"],
              "note": "Cao độ vẽ 'đường viền' cho từ, không có đường nét uốn lượn"
            }
          }
        },
        {
          "id": "2.2",
          "title": "Quy tắc Vàng của Tokyo",
          "golden_rule": "Cao độ PHẢI thay đổi giữa mora thứ 1 và mora thứ 2",
          "rules": [
            "Nếu mora 1 là Thấp → mora 2 phải là Cao",
            "Nếu mora 1 là Cao → mora 2 phải là Thấp"
          ]
        },
        {
          "id": "2.3",
          "title": "Bốn Mô hình Trọng âm",
