            {"type": "Nakadaka", "name_vi": "Giữa cao", "pattern": "L-H...-L", "example": "卵 (Tamago)", "pronunciation": "L-H-L"},
            {"type": "Odaka", "name_vi": "Đuôi cao", "pattern": "L-H-H (trợ từ L)", "example": "花 (Hana)", "pronunciation": "L-H"}
