            {"formal": "-ui", "casual": "-ii", "example": "warui → warii", "meaning": "xấu"}
          ]
        },
        {
          "id": "6.2",
          "title": "Rút gọn Dạng '-te'",
          "te_contractions": [
            {"formal": "-te shimau", "casual": "-chau", "meaning": "Lỡ làm/Hoàn thành"},
            {"formal": "-de shimau", "casual": "-jau", "meaning": "Lỡ làm/Hoàn thành"},
            {"formal": "-te iru", "casual": "-teru", "meaning": "Đang làm"},
            {"formal": "-de iru", "casual": "-deru", "meaning": "Đang làm"},
            {"formal": "-te oku", "casual": "-toku", "meaning": "Làm sẵn"},
            {"formal": "-de oku", "casual": "-doku", "meaning": "Làm sẵn"}
          ]
        },
        {
          "id": "6.3",
          "title": "Ví dụ Thực tế",
          "real_examples": [
            {"formal": "食べてしまいました (tabete shimaimashita)", "casual": "食べちゃった (tabechatta)", "meaning": "Lỡ ăn mất rồi"},
            {"formal": "分からない (wakaranai)", "casual": "分かんない (wakannai)", "meaning": "Không hiểu"}
          ]
        },
        {
          "id": "6.4",
          "title": "Đồng hóa /r/ → /n/",
          "r_to_n_rule": {
            "pattern": "ra + n → nn",
            "examples": [
              {"formal": "wakaranai", "casual": "wakannai"},
              {"formal": "tsumaranai", "casual": "tsumannai"},
              {"formal": "kaerenai", "casual": "kaennai"}
            ]
          }
        }
      ]
    }
  ]
