        {
          "id": "8.1",
          "title": "Định nghĩa",
          "definition": "Sokuon (っ - tsu nhỏ) là khoảng lặng có độ dài = 1 mora, theo sau là phụ âm đôi."
        },
        {
          "id": "8.2",
          "title": "Cơ chế Phát âm",
          "mechanism": {
            "example": "Kitte (切手 - tem thư) = Ki + (ngưng) + te",
            "wrong": "Kít-tê (nhấn mạnh như trọng âm)",
            "correct": "Ki-(giữ hơi 1 nhịp)-te",
            "concept": {
              "name": "Khoảng lặng Tích cực",
              "features": [
                "Cơ quan phát âm duy trì áp lực cao",
                "Chuẩn bị 'bật' ra phụ âm tiếp theo",
                "Như lò xo đang bị nén"
              ]
            }
          }
        },
        {
          "id": "8.3",
          "title": "Cặp Tối thiểu",
          "minimal_pairs": [
            {"without": "きて (kite)", "with": "きって (kitte)", "difference": "Đến đây vs Tem/Cắt"},
            {"without": "いて (ite)", "with": "いって (itte)", "difference": "Có mặt vs Đi/Nói"},
            {"without": "かこ (kako)", "with": "かっこ (kakko)", "difference": "Quá khứ vs Dấu ngoặc"}
          ]
        },
        {
          "id": "8.4",
          "title": "Tận dụng Phụ âm cuối Tiếng Việt",
          "vietnamese_advantage": {
            "description": "Tiếng Việt có -p, -t, -k cuối không bật hơi",
            "examples": [
              {"word": "hợp", "mechanism": "môi khép, giữ hơi"},
              {"word": "hát", "mechanism": "lưỡi chạm lợi, giữ hơi"},
              {"word": "học", "mechanism": "cuống lưỡi chạm ngạc, giữ hơi"}
            ],
            "insight": "Đây chính là cơ chế giống Sokuon!",
            "exercise": "Phát âm 'hợp' → giữ → 'pô' = 'hợp-pô'"
