  "common_mistakes": {
    "description": "Lỗi phổ biến khi nghe/phát âm trường âm",
    "mistakes": [
      {
        "type": "Không nghe ra trường âm",
        "example": "Nghe おばあさん thành おばさん",
        "consequence": "Nhầm 'bà' thành 'cô'",
        "tip": "Tập đếm mora khi nghe"
      },
      {
        "type": "Phát âm ei thành e-i tách biệt",
        "example": "せんせい phát âm thành sen-se-i thay vì sen-see",
        "consequence": "Nghe không tự nhiên",
        "tip": "ei phát âm như ee kéo dài"
      },
      {
        "type": "Phát âm ou thành o-u tách biệt",
        "example": "がっこう phát âm thành gak-ko-u thay vì gak-koo",
        "consequence": "Nghe không tự nhiên",
        "tip": "ou phát âm như oo kéo dài"
      },
