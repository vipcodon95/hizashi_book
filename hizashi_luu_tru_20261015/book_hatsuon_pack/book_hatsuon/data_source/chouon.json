{
  "metadata": {
    "version": "1.0",
    "description": "Trường âm tiếng Nhật (長音) - Long vowels",
    "name_vi": "Trường âm",
    "name_jp": "長音",
    "note": "Trường âm kéo dài nguyên âm thêm 1 mora (2 mora tổng cộng)"
  },
  "rules": {
    "hiragana": {
      "description": "Quy tắc viết trường âm trong Hiragana",
      "patterns": [
        { "vowel": "a", "extension": "あ", "example": "おかあさん", "romaji": "okaasan" },
        { "vowel": "i", "extension": "い", "example": "おにいさん", "romaji": "oniisan" },
        { "vowel": "u", "extension": "う", "example": "くうき", "romaji": "kuuki" },
        { "vowel": "e", "extension": "い (hoặc え)", "example": "せんせい / おねえさん", "romaji": "sensei / oneesan", "note": "Phần lớn dùng い, một số ít dùng え" },
        { "vowel": "o", "extension": "う (hoặc お)", "example": "がっこう / おおきい", "romaji": "gakkou / ookii", "note": "Phần lớn dùng う, một số ít dùng お" }
      ]
    },
    "katakana": {
      "description": "Quy tắc viết trường âm trong Katakana",
      "note": "Katakana dùng ー cho tất cả trường âm",
      "symbol": "ー",
      "examples": [
        { "word": "コーヒー", "romaji": "koohii", "meaning": "cà phê" },
        { "word": "ケーキ", "romaji": "keeki", "meaning": "bánh kem" },
        { "word": "カー", "romaji": "kaa", "meaning": "xe hơi (car)" }
      ]
    }
  },
  "long_vowels": {
    "aa": {
      "name": "Trường âm A",
      "hiragana_pattern": "あ段 + あ",
      "duration": "2 mora",
      "examples": [
        { "word": "おかあさん", "katakana": "オカアサン", "romaji": "okaasan", "meaning": "mẹ", "mora_count": 5 },
        { "word": "おばあさん", "katakana": "オバアサン", "romaji": "obaasan", "meaning": "bà", "mora_count": 5 },
        { "word": "ああ", "katakana": "アア", "romaji": "aa", "meaning": "à, ồ", "mora_count": 2 }
      ]
    },
    "ii": {
      "name": "Trường âm I",
      "hiragana_pattern": "い段 + い",
      "duration": "2 mora",
      "examples": [
        { "word": "おにいさん", "katakana": "オニイサン", "romaji": "oniisan", "meaning": "anh trai", "mora_count": 5 },
        { "word": "おじいさん", "katakana": "オジイサン", "romaji": "ojiisan", "meaning": "ông", "mora_count": 5 },
        { "word": "いい", "katakana": "イイ", "romaji": "ii", "meaning": "tốt", "mora_count": 2 },
        { "word": "かわいい", "katakana": "カワイイ", "romaji": "kawaii", "meaning": "dễ thương", "mora_count": 4 }
      ]
    },
    "uu": {
      "name": "Trường âm U",
      "hiragana_pattern": "う段 + う",
      "duration": "2 mora",
      "examples": [
        { "word": "くうき", "katakana": "クウキ", "romaji": "kuuki", "meaning": "không khí", "mora_count": 3 },
        { "word": "すうがく", "katakana": "スウガク", "romaji": "suugaku", "meaning": "toán học", "mora_count": 4 },
        { "word": "ゆうめい", "katakana": "ユウメイ", "romaji": "yuumei", "meaning": "nổi tiếng", "mora_count": 4 },
        { "word": "じゅう", "katakana": "ジュウ", "romaji": "juu", "meaning": "mười", "mora_count": 2 }
      ]
    },
    "ei": {
      "name": "Trường âm E (dạng ei)",
      "hiragana_pattern": "え段 + い",
      "duration": "2 mora",
      "note": "Phát âm như 'ee' kéo dài, không phải 'e-i' tách biệt",
      "examples": [
        { "word": "せんせい", "katakana": "センセイ", "romaji": "sensei", "meaning": "giáo viên", "mora_count": 4 },
        { "word": "えいご", "katakana": "エイゴ", "romaji": "eigo", "meaning": "tiếng Anh", "mora_count": 3 },
        { "word": "けいたい", "katakana": "ケイタイ", "romaji": "keitai", "meaning": "điện thoại", "mora_count": 4 },
        { "word": "めい", "katakana": "メイ", "romaji": "mei", "meaning": "cháu gái", "mora_count": 2 }
      ]
    },
    "ee": {
      "name": "Trường âm E (dạng ee)",
      "hiragana_pattern": "え段 + え",
      "duration": "2 mora",
      "note": "Ít phổ biến hơn ei, chỉ một số từ",
      "examples": [
        { "word": "おねえさん", "katakana": "オネエサン", "romaji": "oneesan", "meaning": "chị gái", "mora_count": 5 },
        { "word": "ええ", "katakana": "エエ", "romaji": "ee", "meaning": "vâng, ừ", "mora_count": 2 }
      ]
    },
    "ou": {
      "name": "Trường âm O (dạng ou)",
      "hiragana_pattern": "お段 + う",
      "duration": "2 mora",
      "note": "Phát âm như 'oo' kéo dài, không phải 'o-u' tách biệt",
      "examples": [
        { "word": "がっこう", "katakana": "ガッコウ", "romaji": "gakkou", "meaning": "trường học", "mora_count": 4 },
        { "word": "とうきょう", "katakana": "トウキョウ", "romaji": "toukyou", "meaning": "Tokyo", "mora_count": 4 },
        { "word": "おとうさん", "katakana": "オトウサン", "romaji": "otousan", "meaning": "bố", "mora_count": 5 },
        { "word": "どうぞ", "katakana": "ドウゾ", "romaji": "douzo", "meaning": "xin mời", "mora_count": 3 },
        { "word": "こうえん", "katakana": "コウエン", "romaji": "kouen", "meaning": "công viên", "mora_count": 4 }
      ]
    },
    "oo": {
      "name": "Trường âm O (dạng oo)",
      "hiragana_pattern": "お段 + お",
      "duration": "2 mora",
      "note": "Ít phổ biến hơn ou, chỉ một số từ",
      "examples": [
        { "word": "おおきい", "katakana": "オオキイ", "romaji": "ookii", "meaning": "to, lớn", "mora_count": 4 },
        { "word": "おおい", "katakana": "オオイ", "romaji": "ooi", "meaning": "nhiều", "mora_count": 3 },
        { "word": "とおい", "katakana": "トオイ", "romaji": "tooi", "meaning": "xa", "mora_count": 3 },
        { "word": "こおり", "katakana": "コオリ", "romaji": "koori", "meaning": "đá (nước đá)", "mora_count": 3 },
        { "word": "おおさか", "katakana": "オオサカ", "romaji": "oosaka", "meaning": "Osaka", "mora_count": 4 }
      ]
    }
  },
  "yoon_long_vowels": {
