            "meaning": "Là vì không có tiền"
          }
        ]
      },
      {
        "id": "L2_03",
        "type": "identify_form",
        "instruction": "Nghe và chọn: FORMAL hay CASUAL?",
        "items": [
          { "audio": "これは本ではありません", "answer": "formal" },
          { "audio": "これ、本じゃない", "answer": "casual" },
          { "audio": "何してんの？", "answer": "casual" },
