          { "audio": "行くんだ", "answer": "casual" },
          { "audio": "行くのです", "answer": "formal" },
          { "audio": "彼女じゃないよ", "answer": "casual" },
          { "audio": "彼女ではありません", "answer": "formal" },
          { "audio": "いいじゃん", "answer": "casual" },
          { "audio": "いいではないですか", "answer": "formal" }
        ]
      },
      {
        "id": "L2_04",
        "type": "listening_comprehension",
        "instruction": "Nghe câu casual và chọn nghĩa đúng",
        "items": [
          {
            "audio": "それ、何？ーーこれ？本だよ。",
            "question": "Đó là gì?",
            "options": ["Sách", "Vở", "Báo"],
            "answer": 0
          },
          {
            "audio": "どこ行くん？ーー学校。",
            "question": "Người nói sẽ đi đâu?",
            "options": ["Nhà", "Trường", "Công ty"],
            "answer": 1
          },
          {
            "audio": "元気じゃないの？ーーうん、ちょっと疲れてる。",
            "question": "Người trả lời cảm thấy thế nào?",
            "options": ["Khỏe", "Mệt", "Vui"],
            "answer": 1
          },
          {
            "audio": "日本人？ーーううん、日本人じゃない。ベトナム人。",
            "question": "Người trả lời là người nước nào?",
            "options": ["Nhật", "Việt Nam", "Trung Quốc"],
            "answer": 1
          },
          {
            "audio": "なんで遅れたん？ーー電車遅れたんだ。",
            "question": "Tại sao người nói đến muộn?",
            "options": ["Dậy muộn", "Tàu bị trễ", "Kẹt xe"],
            "answer": 1
          }
        ]
      },
      {
        "id": "L2_05",
        "type": "fill_blank",
        "instruction": "Nghe và điền từ còn thiếu",
        "items": [
          { "audio": "学生___ない", "answer": "じゃ", "full": "学生じゃない" },
          { "audio": "何して___？", "answer": "るん / んの", "full": "何してるん？ / 何してんの？" },
          { "audio": "好き___ないよ", "answer": "じゃ", "full": "好きじゃないよ" },
          { "audio": "行く___だ", "answer": "ん", "full": "行くんだ" },
          { "audio": "静か___ない", "answer": "じゃ", "full": "静かじゃない" }
        ]
      }
    ]
  },

