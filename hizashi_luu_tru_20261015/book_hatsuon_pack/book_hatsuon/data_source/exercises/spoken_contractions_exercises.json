    "total_levels": 5,
    "exercise_types": ["identify_form", "match_pairs", "fill_blank", "same_or_different", "dictation"],
    "version": "1.0"
  },

  "level_1": {
    "title": "ている → てる (Cơ bản)",
    "description": "Nhận diện dạng rút gọn tiếp diễn - phổ biến nhất",
    "target": "Nghe てる và liên tưởng ngay đến ている",

