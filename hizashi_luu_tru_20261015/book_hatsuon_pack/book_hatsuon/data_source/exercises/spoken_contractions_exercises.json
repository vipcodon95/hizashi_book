        "pairs": [
          {
            "audio_1": "食べている",
            "audio_2": "食べてる",
            "answer": "same",
            "meaning": "Đang ăn"
          },
          {
            "audio_1": "見ている",
            "audio_2": "見てる",
            "answer": "same",
            "meaning": "Đang xem"
          },
          {
            "audio_1": "聞いている",
            "audio_2": "聞いてる",
            "answer": "same",
            "meaning": "Đang nghe"
          },
          {
            "audio_1": "待っている",
            "audio_2": "待ってる",
            "answer": "same",
            "meaning": "Đang đợi"
          },
          {
            "audio_1": "知っている",
            "audio_2": "知ってる",
            "answer": "same",
            "meaning": "Biết"
          },
          {
            "audio_1": "住んでいる",
            "audio_2": "住んでる",
            "answer": "same",
            "meaning": "Đang sống"
          },
          {
            "audio_1": "働いている",
            "audio_2": "働いてる",
            "answer": "same",
            "meaning": "Đang làm việc"
          },
          {
            "audio_1": "寝ている",
            "audio_2": "寝てる",
            "answer": "same",
            "meaning": "Đang ngủ"
          },
          {
            "audio_1": "読んでいる",
            "audio_2": "読んでる",
            "answer": "same",
            "meaning": "Đang đọc"
          },
          {
            "audio_1": "書いている",
            "audio_2": "書いてる",
            "answer": "same",
            "meaning": "Đang viết"
          }
        ]
      },
      {
        "id": "L1_02",
        "type": "identify_form",
        "instruction": "Nghe và chọn: Đây là dạng FORMAL hay CASUAL?",
        "items": [
          { "audio": "何をしていますか", "answer": "formal", "meaning": "Đang làm gì ạ?" },
          { "audio": "何してる", "answer": "casual", "meaning": "Đang làm gì?" },
          { "audio": "テレビを見ています", "answer": "formal", "meaning": "Đang xem TV" },
          { "audio": "テレビ見てる", "answer": "casual", "meaning": "Đang xem TV" },
          { "audio": "今、食べてる", "answer": "casual", "meaning": "Đang ăn" },
          { "audio": "今、食べています", "answer": "formal", "meaning": "Đang ăn ạ" },
          { "audio": "彼女と話してる", "answer": "casual", "meaning": "Đang nói chuyện với cô ấy" },
          { "audio": "彼女と話しています", "answer": "formal", "meaning": "Đang nói chuyện với cô ấy ạ" },
          { "audio": "コーヒー飲んでる", "answer": "casual", "meaning": "Đang uống cà phê" },
          { "audio": "コーヒーを飲んでいます", "answer": "formal", "meaning": "Đang uống cà phê ạ" }
        ]
      },
      {
        "id": "L1_03",
        "type": "match_pairs",
        "instruction": "Nối dạng đầy đủ với dạng rút gọn tương ứng",
        "pairs": [
          { "formal": "勉強している", "casual": "勉強してる", "meaning": "Đang học" },
          { "formal": "走っている", "casual": "走ってる", "meaning": "Đang chạy" },
          { "formal": "泳いでいる", "casual": "泳いでる", "meaning": "Đang bơi" },
          { "formal": "歌っている", "casual": "歌ってる", "meaning": "Đang hát" },
          { "formal": "踊っている", "casual": "踊ってる", "meaning": "Đang nhảy" },
          { "formal": "遊んでいる", "casual": "遊んでる", "meaning": "Đang chơi" },
          { "formal": "考えている", "casual": "考えてる", "meaning": "Đang suy nghĩ" },
          { "formal": "笑っている", "casual": "笑ってる", "meaning": "Đang cười" }
        ]
      },
      {
        "id": "L1_04",
        "type": "listening_comprehension",
        "instruction": "Nghe câu và chọn nghĩa đúng",
        "items": [
          {
            "audio": "今、何してる？",
            "options": ["Bây giờ đang làm gì?", "Bây giờ làm gì?", "Bây giờ sẽ làm gì?"],
            "answer": 0
          },
          {
            "audio": "ご飯食べてる",
            "options": ["Sẽ ăn cơm", "Đang ăn cơm", "Đã ăn cơm"],
            "answer": 1
          },
          {
            "audio": "どこに住んでる？",
            "options": ["Sẽ sống ở đâu?", "Đã sống ở đâu?", "Đang sống ở đâu?"],
            "answer": 2
          },
          {
            "audio": "彼、知ってる？",
            "options": ["Cậu biết anh ấy không?", "Cậu đã biết anh ấy chưa?", "Cậu sẽ biết anh ấy không?"],
            "answer": 0
          },
          {
            "audio": "まだ寝てる",
            "options": ["Vẫn sẽ ngủ", "Vẫn đang ngủ", "Đã ngủ rồi"],
            "answer": 1
          }
        ]
      },
      {
        "id": "L1_05",
        "type": "negative_form",
        "instruction": "Nghe và nhận diện: ていない hay てない?",
        "items": [
          { "audio": "まだ食べてない", "form": "casual", "meaning": "Chưa ăn" },
          { "audio": "まだ食べていない", "form": "formal", "meaning": "Chưa ăn" },
          { "audio": "知らない", "form": "casual", "note": "知る có dạng phủ định đặc biệt", "meaning": "Không biết" },
          { "audio": "見てない", "form": "casual", "meaning": "Chưa xem" },
          { "audio": "聞いていない", "form": "formal", "meaning": "Chưa nghe" },
          { "audio": "やってない", "form": "casual", "meaning": "Chưa làm" },
          { "audio": "行ってない", "form": "casual", "meaning": "Chưa đi" },
          { "audio": "来ていない", "form": "formal", "meaning": "Chưa đến" }
        ]
      }
    ]
  },

  "level_2": {
    "title": "ではない → じゃない & の → ん",
