          },
          {
            "audio": "でんわ",
            "n_variant": "[n]",
            "reason": "trước w (thực tế như trước nguyên âm)",
            "meaning": "điện thoại"
          },
          {
            "audio": "けんこう",
            "n_variant": "[ŋ]",
            "reason": "trước k",
            "meaning": "sức khỏe"
          },
          {
            "audio": "しんねん",
            "n_variant": "[ɲ] và [ɴ]",
            "reason": "trước n = [n], cuối = [ɴ]",
            "meaning": "năm mới"
          }
        ]
      },
      {
        "id": "S2A_L3_02",
        "type": "n_vs_na_advanced",
        "instruction": "Nghe và phân biệt: ん + nguyên âm hay な行?",
