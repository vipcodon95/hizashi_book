          },
          {
            "audio": "てんいん",
            "structure": "て・ん・い・ん",
            "answer": "n_vowel",
            "meaning": "nhân viên",
            "mora": 4
          },
          {
            "audio": "ていいん",
            "structure": "て・い・い・ん",
            "answer": "long_vowel",
            "meaning": "số lượng quy định",
