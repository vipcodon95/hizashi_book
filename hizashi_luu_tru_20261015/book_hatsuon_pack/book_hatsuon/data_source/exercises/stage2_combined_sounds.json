          },
          {
            "audio": "さんい",
            "structure": "さ・ん・い",
            "answer": "n_vowel",
            "meaning": "đồng ý",
            "mora": 3
          }
        ]
      },
      {
        "id": "S2A_L3_03",
        "type": "complex_n_words",
        "instruction": "Nghe từ có nhiều ん và xác định số lượng",
        "items": [
          { "audio": "しんかんせん", "n_count": 3, "meaning": "tàu shinkansen", "mora": 5 },
          { "audio": "にんげん", "n_count": 2, "meaning": "con người", "mora": 4 },
          { "audio": "うんてんしゅ", "n_count": 2, "meaning": "tài xế", "mora": 5 },
