{
  "metadata": {
    "title": "Pitch Accent - Cao độ tiếng Nhật",
    "title_jp": "高低アクセント",
    "description": "Hệ thống cao độ (pitch) trong tiếng Nhật - Yếu tố quan trọng để nghe hiểu tự nhiên",
    "importance": "Pitch accent có thể thay đổi nghĩa của từ hoàn toàn",
    "notation": "OJAD style - L(Low), H(High), với downstep marker",
    "version": "1.0"
  },

  "basics": {
    "what_is_pitch_accent": {
      "description": "Tiếng Nhật sử dụng cao độ (pitch) thay vì trọng âm (stress) như tiếng Anh",
      "comparison": {
        "english": "Stress accent - Nhấn mạnh bằng âm lượng và độ dài",
        "japanese": "Pitch accent - Phân biệt bằng cao/thấp của giọng",
        "vietnamese": "Thanh điệu - 6 thanh cố định cho mỗi âm tiết"
      },
      "key_point": "Mỗi mora trong tiếng Nhật có thể ở mức HIGH hoặc LOW"
    },

    "notation_systems": {
      "ojad_style": {
        "description": "Kiểu ký hiệu của Online Japanese Accent Dictionary",
        "symbols": {
          "L": "Low - Thấp",
          "H": "High - Cao",
          "downstep": "Vị trí hạ giọng (từ H xuống L)"
        },
        "example": {
          "word": "にほん",
          "pattern": "LHH",
          "meaning": "Nhật Bản",
          "explanation": "に(L) ほ(H) ん(H)"
        }
      },
      "number_system": {
        "description": "Ký hiệu bằng số chỉ vị trí downstep",
        "rules": [
          "0 = Heiban (平板) - Không có downstep",
          "1 = Atamadaka (頭高) - Downstep sau mora 1",
          "2 = Nakadaka (中高) - Downstep sau mora 2",
          "n = Downstep sau mora thứ n"
        ],
        "example": {
          "word": "はし",
          "accent_1": "1 = Hˡ-ả-shi (đũa) - 箸",
          "accent_2": "2 = hà-SHˡ-i (cầu) - 橋",
          "accent_0": "0 = hà-SHÍ (đầu mút) - 端"
        }
      },
      "visual_line": {
        "description": "Đường kẻ cao/thấp trực quan",
        "example": "にほん: ＿￣￣ (thấp-cao-cao)"
      }
    },

    "basic_rules": [
      {
        "rule": "Mora đầu tiên và mora thứ hai LUÔN khác pitch",
        "explanation": "Nếu mora 1 là L thì mora 2 là H, và ngược lại",
        "examples": [
          { "word": "さくら", "pattern": "LHH", "note": "Bắt đầu L → mora 2 phải H" },
          { "word": "あめ", "pattern": "HL", "note": "Bắt đầu H → mora 2 phải L" }
        ]
      },
      {
        "rule": "Sau khi hạ xuống L, KHÔNG thể lên H lại trong cùng một từ",
        "explanation": "Downstep chỉ xảy ra một lần",
        "valid": "LHHHL ✓",
        "invalid": "LHLHL ✗"
      },
      {
        "rule": "Phương ngữ Tokyo là chuẩn (標準語)",
        "note": "Các vùng khác có thể có pitch khác nhau"
      }
    ]
  },

  "four_patterns": {
    "description": "4 kiểu pitch accent cơ bản trong tiếng Nhật",

    "heiban": {
      "name_jp": "平板型",
      "name_romaji": "Heiban-gata",
      "name_vi": "Kiểu phẳng",
      "accent_number": 0,
      "pattern": "L-H-H-H... (không có downstep)",
      "description": "Bắt đầu thấp, lên cao và GIỮ NGUYÊN cao đến hết từ (kể cả trợ từ sau)",

      "visual": {
        "2_mora": "＿￣ (LH)",
        "3_mora": "＿￣￣ (LHH)",
        "4_mora": "＿￣￣￣ (LHHH)",
        "with_particle": "＿￣￣￣ が￣ (LHHH + が cũng H)"
      },

      "examples": [
        { "word": "はな", "kanji": "花", "pattern": "LH", "meaning": "hoa", "with_ga": "はなが (LHH)" },
        { "word": "さくら", "kanji": "桜", "pattern": "LHH", "meaning": "hoa anh đào" },
        { "word": "にほん", "kanji": "日本", "pattern": "LHH", "meaning": "Nhật Bản" },
        { "word": "おとこ", "kanji": "男", "pattern": "LHH", "meaning": "đàn ông" },
        { "word": "あたま", "kanji": "頭", "pattern": "LHH", "meaning": "đầu" },
        { "word": "ともだち", "kanji": "友達", "pattern": "LHHH", "meaning": "bạn bè" },
        { "word": "たべもの", "kanji": "食べ物", "pattern": "LHHH", "meaning": "đồ ăn" }
      ],

      "key_feature": "Trợ từ sau từ heiban vẫn giữ pitch CAO"
    },

    "atamadaka": {
      "name_jp": "頭高型",
      "name_romaji": "Atamadaka-gata",
      "name_vi": "Kiểu đầu cao",
      "accent_number": 1,
      "pattern": "H-L-L-L... (downstep ngay sau mora 1)",
      "description": "Mora đầu CAO, sau đó tất cả THẤP",

      "visual": {
        "2_mora": "￣＿ (HL)",
        "3_mora": "￣＿＿ (HLL)",
        "4_mora": "￣＿＿＿ (HLLL)",
        "with_particle": "￣＿＿ が＿ (HLL + が cũng L)"
      },

      "examples": [
        { "word": "あめ", "kanji": "雨", "pattern": "HL", "meaning": "mưa" },
        { "word": "いのち", "kanji": "命", "pattern": "HLL", "meaning": "mạng sống" },
        { "word": "いもうと", "kanji": "妹", "pattern": "HLLL", "meaning": "em gái" },
        { "word": "めがね", "kanji": "眼鏡", "pattern": "HLL", "meaning": "kính" },
        { "word": "カメラ", "pattern": "HLL", "meaning": "máy ảnh" },
        { "word": "テレビ", "pattern": "HLL", "meaning": "TV" }
      ],

      "key_feature": "Dễ nhận biết - Chỉ mora đầu tiên cao"
    },

    "nakadaka": {
      "name_jp": "中高型",
      "name_romaji": "Nakadaka-gata",
      "name_vi": "Kiểu giữa cao",
      "accent_number": "2, 3, 4... (tùy vị trí downstep)",
      "pattern": "L-H..H-L-L (downstep ở giữa từ)",
      "description": "Bắt đầu thấp, lên cao, rồi hạ xuống TRƯỚC mora cuối",

      "visual": {
        "3_mora_acc2": "＿￣＿ (LHL) - accent 2",
        "4_mora_acc2": "＿￣＿＿ (LHLL) - accent 2",
        "4_mora_acc3": "＿￣￣＿ (LHHL) - accent 3",
        "with_particle": "＿￣＿ が＿ (LHL + が cũng L)"
      },

      "examples": [
        { "word": "たまご", "kanji": "卵", "pattern": "LHL", "accent": 2, "meaning": "trứng" },
        { "word": "おとうと", "kanji": "弟", "pattern": "LHLL", "accent": 2, "meaning": "em trai" },
        { "word": "おんがく", "kanji": "音楽", "pattern": "LHLL", "accent": 2, "meaning": "âm nhạc" },
        { "word": "あたらしい", "kanji": "新しい", "pattern": "LHHLL", "accent": 3, "meaning": "mới" },
        { "word": "おもしろい", "kanji": "面白い", "pattern": "LHHLL", "accent": 3, "meaning": "thú vị" }
      ],

      "key_feature": "Downstep xảy ra ở giữa - pitch xuống trước khi hết từ"
    },

    "odaka": {
      "name_jp": "尾高型",
      "name_romaji": "Odaka-gata",
      "name_vi": "Kiểu cuối cao",
      "accent_number": "= số mora (downstep sau mora cuối)",
      "pattern": "L-H-H...H↓ (downstep sau mora cuối, thể hiện qua trợ từ)",
      "description": "Giống heiban khi đứng một mình, nhưng trợ từ sau sẽ THẤP",

      "visual": {
        "2_mora": "＿￣ (LH) - giống heiban",
        "2_mora_with_ga": "＿￣ が＿ (LH + が L) - KHÁC heiban!",
        "3_mora": "＿￣￣ (LHH)",
        "3_mora_with_ga": "＿￣￣ が＿ (LHH + が L)"
      },

      "examples": [
        { "word": "はな", "kanji": "鼻", "pattern": "LH", "meaning": "mũi", "with_ga": "はなが (LHL)", "note": "vs 花 (heiban): はなが (LHH)" },
        { "word": "いもうと", "kanji": "妹", "pattern": "LHHH", "accent": 4, "meaning": "em gái", "with_ga": "いもうとが (LHHHL)" },
        { "word": "おとこ", "kanji": "男", "pattern": "LHH", "meaning": "đàn ông", "with_ga": "おとこが (LHHL)" },
        { "word": "やま", "kanji": "山", "pattern": "LH", "meaning": "núi", "with_ga": "やまが (LHL)" },
        { "word": "うみ", "kanji": "海", "pattern": "LH", "meaning": "biển", "with_ga": "うみが (LHL)" }
      ],

      "key_feature": "Chỉ phân biệt được với heiban khi có trợ từ theo sau",
      "importance": "Quan trọng để nghe hiểu câu hoàn chỉnh"
    }
  },

