{
  "metadata": {
    "title": "Question Schema - Chuẩn hóa cấu trúc câu hỏi",
    "description": "Schema thống nhất cho tất cả câu hỏi trong hệ thống luyện nghe",
    "version": "1.0",
    "created_date": "2024"
  },

  "analysis_summary": {
    "total_exercises": 937,
    "with_type_field": 208,
    "without_type_field": 729,
    "unique_types_found": 121,
    "recommendation": "Gom 121 types thành 8 base types để dễ xử lý"
  },

  "base_question_types": {
    "description": "8 loại câu hỏi cơ bản, tất cả 121 types cũ có thể map vào",
    "types": [
      {
        "type_id": "single_choice",
        "name": "Chọn một đáp án",
