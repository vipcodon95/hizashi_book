        "percentage": "~3%"
      }
    ]
  },

  "unified_schema": {
    "description": "Cấu trúc thống nhất cho TẤT CẢ câu hỏi",
    "required_fields": {
      "id": {
        "type": "string",
        "description": "ID duy nhất của câu hỏi",
        "example": "alphabet_001"
      },
      "base_type": {
        "type": "enum",
        "values": ["single_choice", "same_different", "minimal_pair", "counting", "dictation", "matching", "dialogue", "announcement"],
        "description": "1 trong 8 loại cơ bản"
      },
      "sub_type": {
        "type": "string",
        "description": "Loại chi tiết (giữ lại để phân tích)",
        "example": "identify_pattern"
      },
      "audio_ids": {
        "type": "array<string>",
        "description": "Danh sách ID audio cần phát",
        "example": ["audio_001", "audio_002"]
      },
      "prompt": {
        "type": "string",
        "description": "Câu hỏi/hướng dẫn hiển thị cho user",
        "example": "Từ bạn nghe có nghĩa gì?"
      },
      "difficulty": {
        "type": "enum",
        "values": ["easy", "medium", "hard"],
        "description": "Độ khó"
      }
    },

    "optional_fields": {
      "options": {
        "type": "array<Option>",
        "description": "Các lựa chọn (cho single_choice, same_different)",
        "schema": {
          "id": "string",
          "text": "string",
          "is_correct": "boolean"
        }
      },
      "correct_answer": {
        "type": "string | number | array",
        "description": "Đáp án đúng (cho dictation, counting)"
      },
      "context": {
        "type": "Context",
        "description": "Ngữ cảnh (cho dialogue, announcement)",
        "schema": {
          "situation": "string",
          "speakers": "array<Speaker>",
          "transcript": "string"
        }
      },
      "pairs": {
        "type": "array<Pair>",
        "description": "Các cặp cần nối (cho matching)",
        "schema": {
          "left_id": "string",
          "right_id": "string"
        }
      },
      "hints": {
        "type": "array<string>",
        "description": "Gợi ý cho user"
      },
      "explanation": {
        "type": "string",
        "description": "Giải thích sau khi trả lời"
      },
      "topic": {
        "type": "string",
        "description": "Chủ đề (pitch_accent, sokuon, etc.)"
      },
      "tags": {
        "type": "array<string>",
        "description": "Tags để filter/search"
      }
    }
  },

  "database_tables": {
    "description": "Đề xuất cấu trúc database",
    "tables": [
      {
        "name": "questions",
        "columns": [
          {"name": "id", "type": "VARCHAR(50)", "primary": true},
          {"name": "base_type", "type": "ENUM", "index": true},
          {"name": "sub_type", "type": "VARCHAR(50)", "index": true},
          {"name": "prompt", "type": "TEXT"},
          {"name": "difficulty", "type": "ENUM"},
          {"name": "topic", "type": "VARCHAR(50)", "index": true},
          {"name": "source_file", "type": "VARCHAR(100)"},
          {"name": "metadata", "type": "JSON", "description": "Các field bổ sung"}
        ]
      },
      {
        "name": "question_audios",
        "columns": [
          {"name": "id", "type": "INT", "primary": true, "auto": true},
          {"name": "question_id", "type": "VARCHAR(50)", "foreign": "questions.id"},
          {"name": "audio_id", "type": "VARCHAR(50)"},
          {"name": "order_index", "type": "INT"},
          {"name": "label", "type": "VARCHAR(50)", "description": "A, B, hoặc main"}
        ]
      },
      {
        "name": "question_options",
        "columns": [
          {"name": "id", "type": "INT", "primary": true, "auto": true},
          {"name": "question_id", "type": "VARCHAR(50)", "foreign": "questions.id"},
          {"name": "option_index", "type": "INT"},
          {"name": "text", "type": "TEXT"},
          {"name": "is_correct", "type": "BOOLEAN"},
          {"name": "explanation", "type": "TEXT", "nullable": true}
        ]
      },
      {
        "name": "audios",
        "columns": [
          {"name": "id", "type": "VARCHAR(50)", "primary": true},
          {"name": "file_path", "type": "VARCHAR(255)"},
          {"name": "text_content", "type": "TEXT", "description": "Nội dung được nói"},
          {"name": "romaji", "type": "VARCHAR(255)", "nullable": true},
          {"name": "pitch_pattern", "type": "VARCHAR(50)", "nullable": true},
          {"name": "mora_count", "type": "INT", "nullable": true},
          {"name": "speaker", "type": "VARCHAR(50)", "nullable": true},
          {"name": "speed", "type": "ENUM", "values": ["slow", "normal", "fast"]}
        ]
      }
    ]
  },

  "migration_plan": {
    "description": "Kế hoạch chuyển đổi từ JSON sang schema mới",
    "steps": [
      {
        "step": 1,
        "action": "Tạo mapping table",
        "description": "Map 121 types cũ vào 8 base_types"
      },
      {
        "step": 2,
        "action": "Viết converter script",
        "description": "Python script đọc JSON và output theo schema mới"
      },
      {
        "step": 3,
        "action": "Validate data",
        "description": "Kiểm tra tất cả câu hỏi đã được convert đúng"
      },
      {
        "step": 4,
        "action": "Generate audio IDs",
        "description": "Tạo ID cho audio files dựa trên content"
      },
      {
        "step": 5,
        "action": "Export to database",
        "description": "Insert vào database hoặc export JSON mới"
      }
    ]
  },

