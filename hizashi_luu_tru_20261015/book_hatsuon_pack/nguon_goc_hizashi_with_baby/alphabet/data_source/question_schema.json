        "maps_from": [
          "choose_one", "identify_form", "identify_pattern", "identify_sound",
          "identify_intonation", "identify_emotion", "identify_devoicing",
          "identify_focus", "identify_particle", "word_choice", "word_identification",
          "fu_recognition", "shi_chi_distinction", "three_way_choice",
          "question_or_statement", "formal_question", "wh_question",
          "emotion_recognition", "focus_identification", "pattern_recognition",
