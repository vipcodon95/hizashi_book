    "ji_zu_confusion": {
      "title": "じ/ぢ và ず/づ - Cùng phát âm",
      "description": "Trong tiếng Nhật hiện đại, じ và ぢ phát âm giống nhau, ず và づ cũng vậy",

      "ji_di": {
        "pronunciation": "[dʑi] hoặc [ʑi]",
        "rule": "Dùng じ trong hầu hết trường hợp, ぢ chỉ dùng khi:",
        "use_di_when": [
          "Từ ghép mà từ gốc có ち (rendaku): はな + ち → はなぢ",
          "Từ có ち lặp lại: ちぢむ (縮む)"
        ],
        "examples": {
          "ji": ["じかん", "じしょ", "かじ", "ふじさん"],
          "di": ["はなぢ", "ちぢむ", "ちぢれる"]
        }
      },

      "zu_du": {
        "pronunciation": "[dzɯ] hoặc [zɯ]",
        "rule": "Dùng ず trong hầu hết trường hợp, づ chỉ dùng khi:",
        "use_du_when": [
          "Từ ghép mà từ gốc có つ (rendaku): みか + つき → みかづき",
          "Từ có つ biến đổi: つづく (続く), つづける (続ける)"
        ],
        "examples": {
          "zu": ["ずっと", "みず", "かず", "すず"],
          "du": ["つづく", "つづける", "みかづき", "こづつみ"]
        }
      },

      "listening_note": "Khi nghe, không thể phân biệt じ/ぢ hay ず/づ - phải dựa vào ngữ cảnh và kiến thức từ vựng"
