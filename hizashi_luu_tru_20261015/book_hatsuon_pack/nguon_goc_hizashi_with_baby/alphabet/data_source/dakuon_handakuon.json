  "metadata": {
    "title": "Âm đục và Âm bán đục",
    "title_jp": "濁音と半濁音",
    "description": "Chi tiết về dakuon (゛) và handakuon (゜) - Quy tắc biến đổi và luyện nghe",
    "importance": "Phân biệt vô thanh/hữu thanh là yếu tố quan trọng để nghe hiểu tiếng Nhật",
    "version": "1.0"
