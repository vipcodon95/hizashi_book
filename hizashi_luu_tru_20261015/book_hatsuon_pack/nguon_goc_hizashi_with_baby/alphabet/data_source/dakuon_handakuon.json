  "rendaku": {
    "title": "連濁 - Quy tắc biến đổi âm trong từ ghép",
    "reading": "rendaku",
    "description": "Khi ghép từ, âm đầu của từ thứ hai có thể bị đục hóa",

    "basic_rule": {
      "description": "Âm vô thanh đầu từ thứ hai → Âm hữu thanh",
      "examples": [
        { "word1": "て", "word2": "かみ", "compound": "てがみ", "meaning": "thư (tay + giấy)", "change": "か → が" },
        { "word1": "はな", "word2": "ち", "compound": "はなぢ", "meaning": "chảy máu mũi", "change": "ち → ぢ" },
        { "word1": "あお", "word2": "そら", "compound": "あおぞら", "meaning": "bầu trời xanh", "change": "そ → ぞ" },
        { "word1": "もの", "word2": "かたり", "compound": "ものがたり", "meaning": "câu chuyện", "change": "か → が" }
      ]
    },

    "exceptions": {
      "description": "Rendaku KHÔNG xảy ra khi:",
      "rules": [
        {
          "rule": "Từ thứ hai đã có âm đục",
          "reason": "Quy tắc Lyman - không đục hóa nếu đã có dakuon",
          "example": "やま + かぜ → やまかぜ (không phải やまがぜ vì かぜ có ぜ)"
        },
        {
          "rule": "Từ ghép Sino-Japanese (từ Hán)",
          "reason": "Từ Hán-Nhật thường không áp dụng rendaku",
          "example": "がいこく (外国) - không biến đổi"
        },
        {
          "rule": "Từ ghép đẳng lập (A và B)",
          "reason": "Hai từ ngang hàng",
          "example": "やまかわ (山川) - núi VÀ sông"
        }
      ]
    },

    "common_rendaku_words": [
      { "original": "て + かみ", "result": "てがみ", "meaning": "thư" },
      { "original": "はな + ひ", "result": "はなび", "meaning": "pháo hoa" },
      { "original": "い + くち", "result": "いぐち", "meaning": "lối vào" },
      { "original": "こころ + つよい", "result": "こころづよい", "meaning": "vững lòng" },
      { "original": "あめ + ふり", "result": "あめふり", "meaning": "trời mưa", "note": "Không rendaku" }
    ]
  },

