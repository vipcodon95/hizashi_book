  "dakuon": {
    "name_vi": "Âm đục",
    "name_jp": "濁音",
    "reading": "dakuon",
    "mark": "゛",
    "mark_name": "dakuten / nigori",
    "description": "Âm hữu thanh - dây thanh rung khi phát âm",

    "transformation_rules": {
      "description": "Quy tắc biến đổi từ âm vô thanh (清音) sang âm hữu thanh (濁音)",
      "rules": [
        {
          "from": "か行 (ka, ki, ku, ke, ko)",
          "to": "が行 (ga, gi, gu, ge, go)",
          "phonetic_change": "k → g",
          "description": "Âm k vô thanh → âm g hữu thanh"
        },
        {
          "from": "さ行 (sa, shi, su, se, so)",
          "to": "ざ行 (za, ji, zu, ze, zo)",
          "phonetic_change": "s → z, sh → j",
          "description": "Âm s/sh vô thanh → âm z/j hữu thanh"
        },
        {
          "from": "た行 (ta, chi, tsu, te, to)",
          "to": "だ行 (da, ji, zu, de, do)",
          "phonetic_change": "t → d, ch → j, ts → z",
          "description": "Âm t/ch/ts vô thanh → âm d/j/z hữu thanh"
        },
        {
          "from": "は行 (ha, hi, fu, he, ho)",
          "to": "ば行 (ba, bi, bu, be, bo)",
          "phonetic_change": "h/f → b",
          "description": "Âm h/f vô thanh → âm b hữu thanh"
        }
      ]
    },

