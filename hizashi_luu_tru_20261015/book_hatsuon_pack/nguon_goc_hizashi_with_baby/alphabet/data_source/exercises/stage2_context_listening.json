  "level_2": {
    "title": "Hội thoại dài - Nhiều lượt nói",
    "description": "Nghe hội thoại phức tạp hơn với nhiều thông tin",

    "exercises": [
      {
        "id": "S2C_L2_01",
        "type": "extended_dialogue",
        "instruction": "Nghe hội thoại dài và trả lời các câu hỏi chi tiết",

        "dialogues": [
          {
            "situation": "Lên kế hoạch cuối tuần",
            "script": [
              "A: もしもし、たなかさん？",
              "B: あ、やまださん、ひさしぶり！げんき？",
              "A: うん、げんき。ねえ、こんどのどようび、ひまある？",
              "B: どようび...ごぜんちゅうはヨガがあるんだけど、ごごはひまだよ。",
              "A: じゃあ、いっしょにえいがみにいかない？",
              "B: いいね！なにみる？",
              "A: あたらしいアニメえいががあるんだって。ひょうばんいいみたいよ。",
              "B: あ、それみたかった！なんじからにする？",
              "A: さんじのかいがいいかな。おわったらごはんたべにいこう。",
              "B: さんせい！じゃあ、にじはんにえきまえであおう。",
              "A: わかった。たのしみにしてるね！",
              "B: わたしも！じゃあ、どようびね。"
            ],
            "questions": [
              {
                "question": "Họ đang nói chuyện qua gì?",
                "options": ["Trực tiếp", "Điện thoại", "Email"],
                "answer": 1
              },
              {
                "question": "Tanaka có lịch gì buổi sáng thứ Bảy?",
                "options": ["Yoga", "Làm việc", "Gặp bạn"],
                "answer": 0
              },
              {
                "question": "Họ sẽ làm gì cùng nhau?",
                "options": ["Đi mua sắm", "Xem phim", "Đi du lịch"],
                "answer": 1
              },
              {
                "question": "Họ sẽ xem gì?",
                "options": ["Phim hành động", "Phim anime mới", "Phim kinh dị"],
                "answer": 1
              },
              {
                "question": "Xem phim lúc mấy giờ?",
                "options": ["2 giờ", "2 giờ 30", "3 giờ"],
                "answer": 2
              },
              {
                "question": "Họ sẽ gặp nhau ở đâu, lúc mấy giờ?",
                "options": ["Trước ga lúc 2:30", "Trước rạp lúc 3:00", "Nhà hàng lúc 5:00"],
                "answer": 0
              },
              {
                "question": "Sau phim họ sẽ làm gì?",
                "options": ["Về nhà", "Đi ăn", "Đi mua sắm"],
                "answer": 1
              }
            ],
            "key_expressions": [
              "ひさしぶり - lâu rồi không gặp",
              "いっしょに〜いかない？ - đi cùng không?",
              "〜んだって - nghe nói",
              "ひょうばんいい - đánh giá tốt",
              "さんせい - đồng ý"
            ]
          },
          {
            "situation": "Trao đổi về công việc",
            "script": [
              "A: すずきさん、きのうのかいぎ、どうだった？",
              "B: たいへんだったよ。さんじかんもかかった。",
              "A: えー、ながいね。なにをはなしたの？",
              "B: しんせいひんのけいかくについてなんだけど、いけんがわかれちゃって...",
              "A: そうなんだ。けつろんはでた？",
              "B: いちおう、らいしゅうまでにしりょうをまとめることになった。",
              "A: じゃあ、いそがしくなるね。てつだおうか？",
              "B: ほんと？たすかる！データせいりをおねがいできる？",
              "A: もちろん。きんようびまでにやっとくよ。",
              "B: ありがとう！たすかるー！"
            ],
            "questions": [
              {
                "question": "Cuộc họp kéo dài bao lâu?",
                "options": ["1 tiếng", "2 tiếng", "3 tiếng"],
                "answer": 2
              },
              {
                "question": "Họ thảo luận về gì?",
                "options": ["Sản phẩm mới", "Nhân sự", "Tài chính"],
                "answer": 0
              },
              {
                "question": "Kết quả họp như thế nào?",
                "options": ["Đồng ý hết", "Ý kiến khác nhau", "Hủy dự án"],
                "answer": 1
              },
              {
                "question": "B phải làm gì trước tuần sau?",
                "options": ["Họp lại", "Tổng hợp tài liệu", "Báo cáo sếp"],
                "answer": 1
              },
              {
                "question": "A sẽ giúp gì?",
                "options": ["Viết báo cáo", "Sắp xếp dữ liệu", "Liên hệ khách hàng"],
                "answer": 1
              },
              {
                "question": "A hoàn thành trước khi nào?",
                "options": ["Thứ Năm", "Thứ Sáu", "Thứ Bảy"],
                "answer": 1
              }
            ],
            "key_expressions": [
              "たいへんだった - vất vả",
              "〜かかった - mất (thời gian)",
              "いけんがわかれる - ý kiến khác nhau",
              "てつだおうか - để tôi giúp nhé",
              "たすかる - cảm ơn/may quá"
            ]
          }
        ]
      }
    ]
  },

