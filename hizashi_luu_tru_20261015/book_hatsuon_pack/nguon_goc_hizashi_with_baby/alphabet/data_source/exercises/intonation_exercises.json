            "B: あ、それ見たかった↘！行こう行こう↗！",
            "A: やった↗！じゃあ、2時に駅で↘。",
            "B: うん、分かった↘！楽しみ↗！"
          ],
          "questions": [
            {
              "question": "A muốn làm gì vào thứ Bảy?",
              "options": ["Xem phim", "Đi mua sắm", "Ăn uống"],
              "answer": 0
            },
            {
              "question": "B có rảnh buổi sáng không?",
              "options": ["Có", "Không"],
              "answer": 1
            },
            {
              "question": "Họ sẽ xem gì?",
              "options": ["Phim hành động", "Phim anime mới", "Phim kinh dị"],
              "answer": 1
            },
            {
              "question": "B cảm thấy thế nào về kế hoạch?",
              "options": ["Không thích", "Rất hào hứng", "Bình thường"],
              "answer": 1
            },
            {
              "question": "Họ sẽ gặp nhau lúc mấy giờ?",
              "options": ["1 giờ", "2 giờ", "3 giờ"],
              "answer": 1
            }
          ],
          "intonation_notes": [
            "暇↗ - câu hỏi casual",
            "えーと...→ - do dự, suy nghĩ",
            "いいね↗ - đồng ý nhiệt tình",
