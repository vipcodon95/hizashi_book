            "speed": "native",
            "task": "Lặp lại ngay sau khi nghe"
          },
          {
            "audio": "なにをしているんですか",
            "speed": "native",
            "task": "Lặp lại ngay sau khi nghe"
          },
          {
            "audio": "あしたはなんようびですか",
            "speed": "native",
            "task": "Lặp lại ngay sau khi nghe"
          }
        ]
      }
    ]
  },

  "level_4": {
    "title": "Nghe hiểu tổng hợp - Tốc độ cao",
