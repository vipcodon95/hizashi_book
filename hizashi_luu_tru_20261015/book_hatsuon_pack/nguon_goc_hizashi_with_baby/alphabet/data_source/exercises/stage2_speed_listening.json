          },
          {
            "audio": "なにかおてつだいしましょうか (fast)",
            "options": ["Tôi giúp gì được không?", "Bạn cần gì?", "Bạn làm gì?"],
            "answer": 0
          },
          {
            "audio": "もういちどおねがいします (fast)",
            "options": ["Xin nói lại lần nữa", "Xin đừng nói", "Xin nói chậm"],
            "answer": 0
          },
          {
            "audio": "ここにすわってもいいですか (fast)",
            "options": ["Ngồi đây được không?", "Đứng đây được không?", "Đi đây được không?"],
            "answer": 0
          }
        ]
      },
      {
        "id": "S2B_L3_03",
        "type": "shadowing_prep",
        "instruction": "Nghe và lặp lại ngay (shadowing). Chọn 'Đã lặp lại' sau khi hoàn thành.",
        "items": [
          {
            "audio": "すみません、えきはどこですか",
