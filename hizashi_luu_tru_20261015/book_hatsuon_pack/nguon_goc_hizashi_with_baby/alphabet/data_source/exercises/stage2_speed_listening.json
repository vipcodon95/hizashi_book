{
  "metadata": {
    "title": "Stage 2B - Nghe tốc độ thực tế",
    "description": "Luyện nghe ở tốc độ người Nhật nói thực tế, bao gồm âm bị nuốt và rút gọn",
    "prerequisite": "Hoàn thành Stage 1 và Stage 2A",
    "focus": "Natural speed, devoicing, contractions",
    "total_levels": 4,
    "version": "1.0"
  },

  "level_1": {
    "title": "Devoicing - Âm bị nuốt/mất",
    "description": "Nhận diện các nguyên âm bị mất trong lời nói tự nhiên",

    "theory": {
      "description": "Trong tiếng Nhật, nguyên âm i và u thường bị 'devoiced' (vô thanh hóa) khi:",
      "conditions": [
        "Đứng giữa 2 phụ âm vô thanh (k, s, t, h, p)",
        "Đứng ở cuối từ sau phụ âm vô thanh",
        "です、ます - u gần như im lặng"
      ],
      "examples": [
        "です → des'",
        "ます → mas'",
        "すき → s'ki",
        "した → sh'ta"
      ]
    },

    "exercises": [
      {
        "id": "S2B_L1_01",
        "type": "identify_devoiced",
        "instruction": "Nghe và xác định âm nào bị 'nuốt' (devoiced)",
        "items": [
          {
            "audio": "です (natural)",
            "devoiced": "u",
            "full_form": "desu",
            "natural_form": "des'",
            "meaning": "là"
          },
          {
            "audio": "ます (natural)",
            "devoiced": "u",
            "full_form": "masu",
            "natural_form": "mas'",
            "meaning": "trợ động từ"
          },
          {
            "audio": "すき (natural)",
            "devoiced": "u",
            "full_form": "suki",
            "natural_form": "s'ki",
            "meaning": "thích"
          },
          {
            "audio": "した (natural)",
            "devoiced": "i",
            "full_form": "shita",
            "natural_form": "sh'ta",
            "meaning": "đã làm"
          },
          {
            "audio": "きた (natural)",
            "devoiced": "i",
            "full_form": "kita",
            "natural_form": "k'ta",
            "meaning": "đã đến"
          },
          {
            "audio": "ください (natural)",
            "devoiced": "i cuối",
            "full_form": "kudasai",
            "natural_form": "kudasa'",
            "meaning": "xin hãy"
          },
          {
            "audio": "つくる (natural)",
            "devoiced": "u đầu",
            "full_form": "tsukuru",
            "natural_form": "ts'kuru",
            "meaning": "làm/tạo"
          },
          {
            "audio": "ふくろ (natural)",
            "devoiced": "u đầu",
            "full_form": "fukuro",
            "natural_form": "f'kuro",
            "meaning": "túi"
          }
        ]
      },
      {
        "id": "S2B_L1_02",
        "type": "slow_vs_natural",
        "instruction": "Nghe 2 phiên bản: Chậm (đầy đủ) vs Tự nhiên (có devoicing). Xác định bản nào là tự nhiên.",
        "pairs": [
          {
            "audio_slow": "de-su (rõ ràng)",
            "audio_natural": "des' (nuốt u)",
            "word": "です",
            "natural_is": 2
          },
          {
            "audio_slow": "su-ki (rõ ràng)",
            "audio_natural": "s'ki (nuốt u)",
            "word": "すき",
            "natural_is": 2
          },
          {
            "audio_slow": "shi-ta (rõ ràng)",
            "audio_natural": "sh'ta (nuốt i)",
            "word": "した",
            "natural_is": 2
          }
        ]
      },
      {
        "id": "S2B_L1_03",
        "type": "sentence_devoicing",
        "instruction": "Nghe câu ở tốc độ tự nhiên và chọn nghĩa đúng",
        "items": [
          {
            "audio": "すきです (natural: s'ki des')",
            "options": ["Tôi thích", "Tôi ghét", "Tôi muốn"],
            "answer": 0
          },
          {
            "audio": "たべました (natural: tabemash'ta)",
            "options": ["Đã ăn", "Sẽ ăn", "Đang ăn"],
            "answer": 0
          },
          {
            "audio": "きてください (natural: k'te kudasa')",
            "options": ["Xin hãy đến", "Xin hãy mặc", "Xin hãy cắt"],
            "answer": 0
          },
          {
            "audio": "つくりました (natural: ts'kurimash'ta)",
            "options": ["Đã làm", "Đã đi", "Đã nói"],
            "answer": 0
          }
        ]
      }
    ]
  },

  "level_2": {
    "title": "Contractions nhanh",
    "description": "Rút gọn trong văn nói ở tốc độ cao",

    "exercises": [
      {
        "id": "S2B_L2_01",
        "type": "fast_contraction_recognition",
        "instruction": "Nghe rút gọn nhanh và chọn dạng đầy đủ",
        "items": [
          {
            "audio": "なにしてんの (nhanh)",
            "full_form": "何をしているの",
            "options": ["何をしているの", "何をするの", "何をしたの"],
            "answer": 0
          },
          {
            "audio": "わかんない (nhanh)",
            "full_form": "わからない",
            "options": ["わからない", "わかった", "わかる"],
            "answer": 0
          },
          {
            "audio": "やんなきゃ (nhanh)",
            "full_form": "やらなければ",
            "options": ["やらなければ", "やりたい", "やった"],
            "answer": 0
          },
          {
            "audio": "食べちゃった (nhanh)",
            "full_form": "食べてしまった",
            "options": ["食べてしまった", "食べている", "食べたい"],
            "answer": 0
          },
          {
            "audio": "行っとく (nhanh)",
            "full_form": "行っておく",
            "options": ["行っておく", "行っている", "行った"],
            "answer": 0
          },
          {
            "audio": "そうじゃん (nhanh)",
            "full_form": "そうじゃないか",
            "options": ["そうじゃないか", "そうです", "そうじゃない"],
            "answer": 0
          }
        ]
      },
      {
        "id": "S2B_L2_02",
        "type": "speed_understanding",
        "instruction": "Nghe câu nói nhanh và chọn nghĩa (2 giây để trả lời)",
        "items": [
          {
            "audio": "ちょっとまってて",
            "meaning": "Đợi chút",
            "speed": "fast"
          },
          {
            "audio": "なにいってんの",
            "meaning": "Đang nói gì vậy?",
            "speed": "fast"
          },
          {
            "audio": "もういかなきゃ",
            "meaning": "Phải đi rồi",
            "speed": "fast"
          },
          {
            "audio": "ぜんぜんわかんない",
            "meaning": "Hoàn toàn không hiểu",
            "speed": "fast"
          },
          {
            "audio": "それってどういうこと",
            "meaning": "Điều đó nghĩa là gì?",
            "speed": "fast"
          }
        ]
      },
      {
        "id": "S2B_L2_03",
        "type": "multiple_contractions",
        "instruction": "Nghe câu có NHIỀU rút gọn và xác định tất cả",
        "items": [
          {
            "audio": "なんでいかないの？いきたくないってこと？",
            "contractions": ["なんで (なぜ)", "いかない (行かない)", "いきたくないって (行きたくないと言う)"],
            "meaning": "Sao không đi? Ý là không muốn đi hả?"
          },
          {
            "audio": "あしたテストあるんだって。べんきょうしなきゃ。",
            "contractions": ["あるんだって (あるのだと)", "しなきゃ (しなければ)"],
            "meaning": "Nghe nói mai có test. Phải học thôi."
          },
          {
            "audio": "それ、たべちゃっていい？おなかすいてんの。",
            "contractions": ["たべちゃって (食べてしまって)", "すいてんの (すいているの)"],
            "meaning": "Ăn cái đó được không? Đói bụng rồi."
          }
        ]
      }
    ]
  },

  "level_3": {
    "title": "Nghe tốc độ Native",
    "description": "Nghe ở tốc độ người bản xứ nói chuyện thực tế",

    "exercises": [
      {
        "id": "S2B_L3_01",
        "type": "native_speed_word",
        "instruction": "Nghe từ ở tốc độ native và chọn từ đúng (2 giây)",
        "items": [
          { "audio": "ありがとうございます (fast)", "answer": "ありがとうございます" },
          { "audio": "すみません (fast)", "answer": "すみません" },
          { "audio": "よろしくおねがいします (fast)", "answer": "よろしくおねがいします" },
          { "audio": "おつかれさまです (fast)", "answer": "おつかれさまです" },
          { "audio": "いただきます (fast)", "answer": "いただきます" },
          { "audio": "ごちそうさまでした (fast)", "answer": "ごちそうさまでした" }
        ]
      },
      {
        "id": "S2B_L3_02",
        "type": "native_speed_sentence",
        "instruction": "Nghe câu ở tốc độ native và chọn nghĩa đúng",
        "items": [
          {
            "audio": "ちょっとおまちください (fast)",
