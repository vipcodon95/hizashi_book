{
  "metadata": {
    "version": "1.0",
    "description": "Âm ngắt tiếng Nhật (促音) - Sokuon/Geminate consonant",
    "name_vi": "Âm ngắt",
    "name_jp": "促音",
    "symbol": {
      "hiragana": "っ",
      "katakana": "ッ"
    },
    "note": "Âm ngắt tạo khoảng lặng ngắn (glottal stop) trước phụ âm, chiếm 1 mora"
  },
  "rules": {
    "description": "Quy tắc sử dụng âm ngắt",
    "basics": [
      "っ/ッ luôn đứng trước phụ âm vô thanh: k, s, t, p, ch, sh, ts",
      "っ/ッ chiếm đúng 1 mora",
      "Khi viết romaji, gấp đôi phụ âm sau: kk, ss, tt, pp, cch, ssh, tts",
      "っ/ッ không bao giờ đứng cuối từ (trừ một số thán từ)",
      "っ/ッ không đứng trước nguyên âm hay âm n, m, r, w, y"
    ],
    "pronunciation": {
      "description": "Cách phát âm âm ngắt",
      "steps": [
        "Chuẩn bị miệng ở vị trí của phụ âm tiếp theo",
        "Giữ khoảng lặng trong 1 mora (khoảng 0.1-0.2 giây)",
        "Phát âm phụ âm tiếp theo với lực mạnh hơn bình thường"
      ],
      "tip": "Tưởng tượng như bạn 'nuốt' một âm vào trong"
    }
  },
  "sokuon_types": {
    "description": "Các loại âm ngắt theo phụ âm đi sau",
    "types": {
