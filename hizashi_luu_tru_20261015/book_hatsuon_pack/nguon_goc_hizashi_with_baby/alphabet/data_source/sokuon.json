  "common_mistakes": {
    "description": "Lỗi phổ biến khi nghe/phát âm âm ngắt",
    "mistakes": [
      {
        "type": "Không nghe ra âm ngắt",
        "example": "Nghe いった thành いた",
        "consequence": "Nhầm 'đã đi' thành 'đã ở'",
        "tip": "Tập đếm mora - âm ngắt luôn thêm 1 mora"
      },
      {
        "type": "Bỏ qua âm ngắt khi nói",
        "example": "Nói もっと thành もと",
        "consequence": "Người Nhật có thể không hiểu",
        "tip": "Tạo khoảng dừng rõ ràng trước phụ âm"
      },
      {
        "type": "Phát âm âm ngắt quá dài",
        "example": "Kéo dài khoảng lặng quá lâu",
        "consequence": "Nghe không tự nhiên",
        "tip": "Âm ngắt chỉ bằng 1 mora (~0.1-0.2 giây)"
      },
      {
        "type": "Nhầm lẫn với trường âm",
        "example": "Nghe がっこう, không phân biệt っ và う",
        "consequence": "Viết sai chính tả",
        "tip": "っ tạo 'căng thẳng', trường âm tạo 'kéo dài'"
      }
    ]
  },
