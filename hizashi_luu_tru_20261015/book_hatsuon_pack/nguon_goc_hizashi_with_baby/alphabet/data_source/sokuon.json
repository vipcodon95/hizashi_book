          { "word": "さっか", "katakana": "サッカ", "romaji": "sakka", "meaning": "nhà văn", "mora_count": 3, "mora_breakdown": "sa-Q-ka" },
          { "word": "きっかけ", "katakana": "キッカケ", "romaji": "kikkake", "meaning": "cơ hội, dịp", "mora_count": 4, "mora_breakdown": "ki-Q-ka-ke" },
          { "word": "サッカー", "katakana": "サッカー", "romaji": "sakkaa", "meaning": "bóng đá", "mora_count": 4, "mora_breakdown": "sa-Q-ka-a" },
          { "word": "はっきり", "katakana": "ハッキリ", "romaji": "hakkiri", "meaning": "rõ ràng", "mora_count": 4, "mora_breakdown": "ha-Q-ki-ri" }
