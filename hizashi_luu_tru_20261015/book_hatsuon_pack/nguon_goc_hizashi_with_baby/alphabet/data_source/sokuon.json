  },
  "verb_conjugation": {
    "description": "Âm ngắt trong chia động từ (て形, た形)",
    "note": "Động từ nhóm 1 kết thúc bằng う、つ、る khi chia て/た sẽ có âm ngắt",
    "patterns": [
      {
        "ending": "う、つ、る",
        "te_form": "って",
        "ta_form": "った",
        "examples": [
          { "dict": "かう", "meaning": "mua", "te": "かって", "ta": "かった" },
          { "dict": "まつ", "meaning": "đợi", "te": "まって", "ta": "まった" },
          { "dict": "とる", "meaning": "lấy", "te": "とって", "ta": "とった" },
          { "dict": "いう", "meaning": "nói", "te": "いって", "ta": "いった" }
        ]
      }
    ]
  },
