{
  "metadata": {
    "title": "Rút gọn trong văn nói tiếng Nhật",
    "title_jp": "話し言葉の縮約形",
    "description": "Các dạng rút gọn phổ biến trong giao tiếp hàng ngày - Quan trọng cho nghe hiểu",
    "importance": "Người Nhật thường xuyên sử dụng các dạng rút gọn trong hội thoại. Nếu chỉ học dạng đầy đủ, học viên sẽ rất khó nghe hiểu người bản xứ.",
    "level": "N5-N4",
    "version": "1.0"
  },

  "no_to_n": {
    "title": "の → ん",
    "description": "Trợ từ の thường được phát âm thành ん trong văn nói tự nhiên",
    "rule": "の ở cuối câu hỏi hoặc giải thích thường biến thành ん",

    "patterns": [
      {
        "id": "no_n_question",
        "name": "Câu hỏi với の/ん",
        "formal": "～のですか",
        "casual": "～んですか → ～んだ → ～の？ → ～ん？",
        "usage": "Hỏi lý do, xác nhận thông tin",
        "examples": [
          {
            "formal": "何をしているのですか",
            "casual": "何してるの？ / 何してんの？",
            "romaji_formal": "nani wo shite iru no desu ka",
            "romaji_casual": "nani shiteru no? / nani shitenno?",
            "meaning": "Đang làm gì vậy?"
          },
          {
            "formal": "どこへ行くのですか",
            "casual": "どこ行くの？ / どこ行くん？",
            "romaji_formal": "doko e iku no desu ka",
            "romaji_casual": "doko iku no? / doko ikun?",
            "meaning": "Đi đâu vậy?"
          },
          {
            "formal": "何を食べているのですか",
            "casual": "何食べてんの？",
            "romaji_formal": "nani wo tabete iru no desu ka",
            "romaji_casual": "nani tabetenno?",
            "meaning": "Đang ăn gì vậy?"
          },
          {
            "formal": "誰と話しているのですか",
            "casual": "誰と話してんの？",
            "romaji_formal": "dare to hanashite iru no desu ka",
            "romaji_casual": "dare to hanashitenno?",
            "meaning": "Đang nói chuyện với ai vậy?"
          }
        ]
      },
      {
        "id": "no_n_explanation",
        "name": "Giải thích với の/ん",
        "formal": "～のです",
        "casual": "～んです → ～んだ",
        "usage": "Giải thích lý do, nhấn mạnh",
        "examples": [
          {
            "formal": "疲れているのです",
            "casual": "疲れてるんだ / 疲れてんだ",
            "romaji_formal": "tsukarete iru no desu",
            "romaji_casual": "tsukareteru nda / tsukaretenda",
            "meaning": "Là vì tôi đang mệt"
          },
          {
            "formal": "明日テストがあるのです",
            "casual": "明日テストあるんだ",
            "romaji_formal": "ashita tesuto ga aru no desu",
            "romaji_casual": "ashita tesuto arunda",
            "meaning": "Là vì mai có bài kiểm tra"
          },
          {
            "formal": "お金がないのです",
            "casual": "お金ないんだ",
            "romaji_formal": "okane ga nai no desu",
            "romaji_casual": "okane nainda",
            "meaning": "Là vì không có tiền"
          },
          {
            "formal": "電車が遅れたのです",
            "casual": "電車遅れたんだ",
            "romaji_formal": "densha ga okureta no desu",
            "romaji_casual": "densha okuretanda",
            "meaning": "Là vì tàu bị trễ"
          }
        ]
      },
      {
        "id": "no_n_possessive",
        "name": "の sở hữu → ん (方言/非標準)",
        "description": "Trong một số phương ngữ và văn nói rất casual",
        "note": "Ít phổ biến hơn, chủ yếu trong phương ngữ Kansai",
        "examples": [
          {
            "standard": "私のもの",
            "dialect": "私んもの / わたしんもん",
            "romaji_standard": "watashi no mono",
            "romaji_dialect": "watashin mono",
            "meaning": "Đồ của tôi"
          },
          {
            "standard": "俺の家",
            "dialect": "俺んち",
            "romaji_standard": "ore no ie",
            "romaji_dialect": "orenchi",
            "meaning": "Nhà tao"
          },
          {
            "standard": "君のせい",
            "dialect": "君んせい",
            "romaji_standard": "kimi no sei",
            "romaji_dialect": "kiminsei",
            "meaning": "Lỗi của cậu"
          }
        ]
      }
    ],

    "minimal_pairs_no_n": [
      {
        "pair": ["何してるの", "何してんの"],
        "ipa": ["nani ʃiteɾɯno", "nani ʃitenno"],
        "difference": "の giữ nguyên vs の → ん",
        "both_mean": "Đang làm gì vậy?",
        "formality": "の hơi formal hơn ん một chút"
      },
      {
        "pair": ["行くの？", "行くん？"],
        "ipa": ["ikɯno", "ikɯɴ"],
        "difference": "の rõ ràng vs ん ngắn gọn",
        "both_mean": "Đi hả?",
        "note": "ん nghe tự nhiên hơn trong hội thoại nhanh"
      },
      {
        "pair": ["食べるの", "食べんの"],
        "ipa": ["tabeɾɯno", "tabenno"],
        "difference": "る + の vs ん + の (kết hợp)",
        "both_mean": "Ăn hả?",
        "note": "Cả る và の đều có thể rút gọn"
      }
    ]
  },

  "teiru_contraction": {
